# 한국은행 ECOS API 키. https://ecos.bok.or.kr 에서 발급.
ECOS_API_KEY=

# FRED (세인트루이스 연은) API 키. https://fred.stlouisfed.org/docs/api/api_key.html 에서 발급.
FRED_API_KEY=

# OpenDART API 키. https://opendart.fss.or.kr 에서 발급 (회사채 수요예측 공시 조회용).
DART_API_KEY=

# Anthropic API 키. https://console.anthropic.com 에서 발급.
# LLM_BACKEND=anthropic 일 때만 필요 (실제 모델 호출, 비용 발생). 기본값(mock)은 필요 없음.
ANTHROPIC_API_KEY=

# "mock"(기본값, 비용 없음) 또는 "anthropic"(실제 호출, 비용 발생).
LLM_BACKEND=mock

# LLM_BACKEND=anthropic일 때 쓸 모델. 생략 시 claude-sonnet-5.
ANTHROPIC_MODEL=
